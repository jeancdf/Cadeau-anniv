PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gift_list
# Alternative à DATABASE_URL pour Docker :
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gift_list
# DB_USER=postgres
# DB_PASSWORD=postgres
SECRET_KEY=remplacez-par-une-cle-secrete-longue-et-aleatoire
ADMIN_PASSWORD=remplacez-par-un-mot-de-passe-administrateur
# Origines autorisées pour le frontend en développement ou s'il est hébergé séparément.
# Plusieurs valeurs peuvent être séparées par des virgules.
FRONTEND_ORIGINS=http://localhost:4200
QWEN_API_KEY=remplacez-par-votre-cle-api-openrouter
QWEN_MODEL=qwen/qwen3.7-plus
QWEN_BASE_URL=https://openrouter.ai/api/v1
# Affiliation Awin. AWIN_PUBLISHER_ID = awinaffid du compte editeur.
# Un AWIN_ADVERTISER_<CLE> par programme rejoint : la cle correspond a celle du
# marchand dans MERCHANT_CATALOGUE (routes/shared-lists.js).
AWIN_PUBLISHER_ID=
AWIN_ADVERTISER_CDISCOUNT=
AWIN_ADVERTISER_ALIEXPRESS=
AWIN_ADVERTISER_ITEAWORLD=
AWIN_ADVERTISER_BRICKZONEHUB=
AWIN_ADVERTISER_IMOU=
AWIN_ADVERTISER_SPORTPARTNERS=
